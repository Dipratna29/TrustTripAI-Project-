# Copy to .env for local development. On Render/Railway set these in the dashboard instead.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-chars
PORT=5000
DEBUG=false
TRUST_PROXY=false
REQUIRE_HTTPS_PAYMENTS=false
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API (admin panel URL). Empty = allow all.
CORS_ORIGINS=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: raises the free MyMemory translation quota (fallback provider)
MYMEMORY_EMAIL=

# Optional: without Razorpay keys, online payment is disabled and Cash on Delivery still works
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
EXPO_ACCESS_TOKEN=
