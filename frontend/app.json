{
  "expo": {
    "name": "TrustTrip",
    "slug": "TrustTrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/app icon.png",
    "scheme": "trusttrip",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./src/assets/images/app icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to use the camera to take a profile picture.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos to set a profile picture.",
        "NSLocationWhenInUseUsageDescription": "TrustTrip uses your location to show nearby safety zones and send it with SOS alerts."
      },
      "bundleIdentifier": "com.trusttrip.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/app icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "package": "com.trusttrip.app",
      "versionCode": 1
    },
    "web": {
      "output": "single"
    },
    "extra": {
      "API_BASE_URL": "https://trusttrip-api-r5vu.onrender.com",
      "APP_NAME": "TrustTrip",
      "APP_VERSION": "1.0.0",
      "REQUEST_TIMEOUT": 30000,
      "RAZORPAY_KEY_ID": "",
      "eas": {
        "projectId": "4efc0ed8-0e04-49b9-94ca-0c9c01a377a6"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TrustTrip to access your location."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow TrustTrip to access your photos to set a profile picture.",
          "cameraPermission": "Allow TrustTrip to use the camera to take a profile picture."
        }
      ]
    ],
    "owner": "dipratnakambles-team"
  }
}
